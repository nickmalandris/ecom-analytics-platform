# PostgreSQL
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=analytics_pass
POSTGRES_DB=analytics

# Database URL (used by the application)
DATABASE_URL=postgresql://analytics_user:analytics_pass@localhost:5435/analytics

# LLM Configuration (pydantic-ai)
# Supported: openai, anthropic, google
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash

# API Keys (set the one matching your LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Admin API Key (for tenant management endpoints)
ADMIN_API_KEY=sk_admin_dev_key_001

# Shopify (custom app credentials)
# Option 1: Direct access token (from custom app API credentials)
SHOPIFY_ACCESS_TOKEN=
# Option 2: Client credentials (auto-generates access token)
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET_KEY=
# Store URL (e.g. your-store.myshopify.com)
SHOPIFY_STORE_URL=

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
