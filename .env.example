# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database URL (used by the application)
DATABASE_URL=
ENCRYPTION_KEY=

# LLM Configuration (pydantic-ai)
# Supported: openai, anthropic, google
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash

# API Keys (set the one matching your LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Admin API Key (for tenant management endpoints)
ADMIN_API_KEY=sk_admin_dev_key_001

# Shopify (client credentials — tokens auto-refresh every 24h)
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET_KEY=
# Store URL (e.g. your-store.myshopify.com)
SHOPIFY_STORE_URL=

# Meta / Facebook social login
META_APP_ID=
META_APP_SECRET=

# Meta Marketing API connector (separate app with Marketing API product)
META_CONNECTOR_APP_ID=
META_CONNECTOR_APP_SECRET=

# Legacy: manual token + account (optional, for CLI scripts)
META_SHORT_LIVED_TOKEN=
META_AD_ACCOUNT_ID=

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
